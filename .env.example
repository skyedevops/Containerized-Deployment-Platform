# --- Application ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.1.0

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_MAX=10
POSTGRES_SSL=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=300

# --- Observability ---
METRICS_PATH=/metrics
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
